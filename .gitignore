/data/*.db-shm

# Large AI-generated social drafts (regenerate with npm run generate:social)
/public/social/buzzdrop-fb-*.png

# Generated ad videos — local only; upload to Railway with npm run push:videos
/public/social/videos/*.mp4
/public/social/videos/*-slide.jpg
/public/social/videos/TIKTOK-MANUAL-PACK.md
